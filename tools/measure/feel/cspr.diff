diff --git a/spec/render.asm b/spec/render.asm
index 4a5581e..09a7d25 100755
--- a/spec/render.asm
+++ b/spec/render.asm
@@ -868,6 +868,58 @@ draw_sprite16:
     add a,a
     or c
     ld e,a
+    ifdef CSPR
+    ; Proof of concept (10 November 2026), simulator only: sprites whose
+    ; pattern has code generated for it are drawn by that code, the others
+    ; by the loop below.  The table (at 3E00 in the simulator: memory the
+    ; 128K does not have; on a real machine it would be in fixed memory)
+    ; has a byte per Konami pattern (0-63, its number / 4): non-zero if
+    ; compiled; the ship's patterns (ship_pat, three frames) are tested by
+    ; address.  The simulator puts the code for (DE, A) at 2000h at
+    ; .cspr_hook.
+    ld a,h
+    cp 0xC0
+    jr c,.cs_low                ; the ship's (ship_pat) or edge_pat
+    sub 0xF8
+    add a,a
+    add a,a
+    add a,a
+    ld b,a
+    ld a,l
+    rlca
+    rlca
+    rlca
+    and 7
+    or b                        ; Konami's pattern number / 4
+    ld c,l
+    ld l,a
+    ld b,h
+    ld h,0x3E
+    ld a,(hl)
+    ld l,c
+    ld h,b
+    or a
+    jr z,.cs_loop
+.cs_go:
+    ld a,(sp_x)
+    and 7
+    ex de,hl                    ; HL the screen, DE the pattern
+.cspr_hook:
+    call 0x2000
+    jp .attrs
+.cs_low:
+    ld a,(0x3E40)               ; non-zero: the ship's patterns compiled
+    or a
+    jr z,.cs_loop
+    ld a,h
+    cp ship_pat>>8
+    jr nz,.cs_loop
+    ld a,l
+    sub ship_pat&0xff
+    cp 96
+    jr c,.cs_go
+.cs_loop:
+    endif
     ld ixl,16
     ld a,(sp_x)
     and 7
