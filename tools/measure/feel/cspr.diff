     defs.append('-DFRAMES_PER_TICK=%d' % int(os.environ.get('NEM_FPT', '1')))
     if draw_every:
         defs.append('-DFLIP_FRAMES=%d' % int(os.environ.get('NEM_FLIP', '3')))
