# Konami's cartridge and the disassembly built from it are not part of this
# project: supply your own copies (see README.md, "Building from source").
/nem.rom
/ref/
# The MSX2 patch's IPS and the ROM it makes: used only by
# local/tools/msx2/msx2_extract.py, not by the build
/*.ips
/nemmsx2.rom

# Generated by the build (Konami's code and data, relocated, among them)
spec/konami_spec.asm
spec/konami_spec_stubs.asm
spec/tables.asm
spec/fullcmp_gen.asm
spec/version.inc
spec/native_data.asm
spec/native_tables.asm
spec/native/
spec/nemesis*.sna
spec/nemesis*.tap
spec/nemesis*.sym
spec/nemesis*.lst
spec/nx_syms.inc
spec/nx_low.bin
spec/nx_low.lst
spec/nx_low.sym
spec/nx_lsyms.inc
spec/nx_tur.bin
spec/nx_tur.lst
spec/nx_tur.sym
spec/nxbuild.log
spec/nx_gfx.dat
*.nex
spec/tape/loader.asm
spec/tape/loader.bin
spec/tape/loader.sym
spec/release/
reloc/*.bin
reloc/*.asm
reloc/*_report.txt

# Captured from running the game (Konami's graphics), and scratch output
spec/*.pkl
spec/shots/
msxsim/*.pkl
msxsim/*.png

__pycache__/
